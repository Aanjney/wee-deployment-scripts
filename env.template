# -----------------------------------------------------------------------------
# VPS checklist for the edge deploy stack (compose + Caddy + scripts).
# This is NOT your application’s secrets file — put those in each service repo
# (e.g. ~/services/webapp/.env) if compose uses env_file.
# -----------------------------------------------------------------------------

# --- Layout (typical) ---
#   ~/deploy/                 docker-compose.yml, Caddyfile, *.sh
#   ~/services/<app-name>/    git clone + Dockerfile + optional .env

# --- Host prerequisites ---
# - Docker Engine + docker compose plugin
# - git (for pull-and-deploy scripts)
# - Ports 80 / 443 allowed to the VPS
# - DNS for each public hostname → this machine’s IP
# - Read-only deploy key or token for private Git remotes (if used)

# --- Per service (set when running scripts or in cron) ---
# DEPLOY_SERVICE=webapi              # name in docker-compose.yml
# DEPLOY_REPO=/home/you/services/webapi
# DEPLOY_REMOTE=origin
# DEPLOY_BRANCH=main

# --- Rolling deploy: how to wait for the new container ---
# Option A — HTTP inside the container (APIs, dynamic sites):
#   DEPLOY_HEALTH_URL=http://127.0.0.1:8000/health
#
# Option B — no URL (static nginx, or image without a probe): fixed sleep instead of curl:
#   DEPLOY_HEALTH_URL=SKIP
#   DEPLOY_STABILIZE_SECONDS=20
#
# Option C — pure static files only in Caddy (file_server, no backend container):
#   Do not use this rolling script for that site; publish files + `caddy reload`.
#   See Deploy.md.

# --- Optional ---
# DEPLOY_COMPOSE_FILE=/home/you/deploy/docker-compose.yml
# COMPOSE_PROJECT_NAME=edge          # must match top-level `name:` in compose
# DEPLOY_SKIP_ENV_CHECK=1            # if the service repo has no .env at root
# DEPLOY_LOCK=/var/lock/deploy-webapi.lock
# DEPLOY_LOG_FILE=/var/log/deploy-webapi.log
