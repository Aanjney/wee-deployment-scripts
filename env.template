# VPS checklist (comments only). App secrets → ~/services/<app>/.env

# Layout:
#   ~/wee-deployment-scripts/   compose, Caddy, scripts
#   ~/services/<app>/           git clone or data dir + .env

# Host: Docker + compose plugin, git, ports 80/443, DNS → this machine

# Type 2 auto-deploy (cron env vars):
# DEPLOY_SERVICE=myapp
# DEPLOY_REPO=/home/you/services/myapp
# DEPLOY_LOCK=/var/lock/deploy-myapp.lock
# DEPLOY_LOG_FILE=/var/log/deploy-myapp.log

# Cron example:
# * * * * * DEPLOY_SERVICE=myapp DEPLOY_REPO=/home/you/services/myapp DEPLOY_LOCK=/var/lock/deploy-myapp.lock DEPLOY_LOG_FILE=/var/log/deploy-myapp.log /home/you/wee-deployment-scripts/run-with-lock.sh
